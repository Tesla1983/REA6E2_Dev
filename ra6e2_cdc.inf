; RA6E2 CDC-ACM 主机侧驱动绑定
; 目的: 给 USB\VID_045B&PID_0263&MI_00 一个本地、确定的 usbser 绑定,
;       让 Windows 跳过驱动查询 / 调制解调器检测(根治"重启后 ~30s 才出 COM")。
;
; 原理: 系统自带 usbser.inf 只在 [Standard.NTamd64] 里按**兼容 ID**匹配:
;         USB\Class_02&SubClass_02&Prot_01  /  USB\Class_02&SubClass_02
;       而我们设备的**硬件 ID** 是 USB\VID_045B&PID_0263&MI_00 —— 硬件 ID 优先于兼容 ID,
;       Windows 找不到本地匹配时会去查 Windows Update, 超时约 30s 才回落到 usbser,
;       表现为"提示音已响但要等 ~30s 才出 COM"(实测每次重枚举都是 ~29.7s/29.8s)。
;       本 INF 按硬件 ID 直接给设备一个本地 usbser 绑定, 使 Windows 无需联网查询。
;
; 已核实(2026-10-25): usbser.inf 里的 UsbSerial_ModemFilter_Install **没有硬件 ID**,
;       其注释为 "for use with Include/Needs only" —— 即 usbser.inf 自身并不会给设备挂
;       modem filter。所以"调制解调器检测"并非这里的根因, 真正要解决的是"硬件 ID 无本地
;       驱动 -> 查 Windows Update"。本 INF 只 Include/Needs UsbSerial_Install.NT。
;
; 安装(需管理员):
;   cd /d <本文件所在目录>
;   pnputil /add-driver ra6e2_cdc.inf /install
; 若提示"驱动未签名"而被拒, 见文件末尾"签名说明"。
;
; 注: 本 INF 不携带任何驱动二进制, 仅引用系统内置 usbser.sys, 可逆
;     (pnputil /delete-driver ra6e2_cdc.inf /uninstall 即可移除)。

[Version]
Signature   = "$WINDOWS NT$"
Class       = Ports
ClassGuid   = {4D36E978-E325-11CE-BFC1-08002BE10318}
Provider    = %Provider%
DriverVer   = 10/25/2026,1.0.0.0

[Manufacturer]
%Manufacturer% = RA6E2_CDC, NTamd64

[RA6E2_CDC.NTamd64]
%DeviceDesc% = RA6E2_CDC_Install, USB\VID_045B&PID_0263&MI_00

[RA6E2_CDC_Install.NT]
Include = usbser.inf
Needs   = UsbSerial_Install.NT

[RA6E2_CDC_Install.NT.Services]
Include = usbser.inf
Needs   = UsbSerial_Install.NT.Services

[Strings]
Provider     = "Renesas"
Manufacturer = "Renesas RA6E2"
DeviceDesc   = "RA6E2 CDC USB Demo (usbser)"

; --- 签名说明 ---
; 现代 Windows(1607+/启用驱动签名强制)下, pnputil /add-driver 要求驱动包已签名。
; 本 INF 仅引用内置 usbser.sys, 但 INF 包本身无 CatalogFile, 可能被拒。两种解决:
;   (1) 设备管理器 -> 该设备 -> 更新驱动 -> 浏览此目录 -> 仍可能警告, 选"仍安装";
;   (2) 或临时开启测试签名(系统级改动, 需你明确授权并亲跑):
;         bcdedit /set testsigning on
;         重启后再 pnputil /add-driver ra6e2_cdc.inf /install
;         (用毕再 bcdedit /set testsigning off 关闭)
